{
  "name": "hello-electron",
  "version": "1.0.0",
  "description": "Electron app",
  "main": "main.js",
  "scripts": {
    "start": "electron . --ignore-certificate-errors",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^25.3.1",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.example.hello-electron",
    "productName": "Electron-app",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
